<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>For Shaina ❤️</title>

<style>
body {
    margin: 0;
    font-family: 'Segoe UI', sans-serif;
    background: linear-gradient(135deg, #ff9a9e, #fecfef);
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100vh;
    text-align: center;
}

.container {
    background: white;
    padding: 30px 20px;
    border-radius: 20px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.2);
    max-width: 360px;
    width: 90%;
    position: relative;
}

h1 {
    color: #ff4d6d;
    margin-bottom: 10px;
    font-size: 1.8rem;
}

p {
    color: #555;
    font-size: 16px;
    margin-bottom: 25px;
    line-height: 1.5;
}

.buttons {
    position: relative;
    height: 100px;
}

button {
    padding: 12px 25px;
    font-size: 16px;
    border: none;
    border-radius: 25px;
    cursor: pointer;
    transition: 0.3s;
    min-width: 100px;
}

#yesBtn {
    background-color: #ff4d6d;
    color: white;
}

#yesBtn:hover {
    background-color: #ff1e4d;
}

#noBtn {
    background-color: #ddd;
    position: absolute;
    left: 50%;
    transform: translateX(0);
}

.heart {
    font-size: 40px;
    animation: float 2s infinite;
}

@keyframes float {
    0% { transform: translateY(0px); }
    50% { transform: translateY(-10px); }
    100% { transform: translateY(0px); }
}

.success {
    font-size: 18px;
    color: #ff4d6d;
    font-weight: bold;
}

/* Responsive for iPhone / small devices */
@media (max-width: 480px) {
    h1 {
        font-size: 1.5rem;
    }
    p {
        font-size: 14px;
    }
    .buttons {
        height: 120px;
    }
    button {
        padding: 10px 18px;
        font-size: 14px;
    }
}

/* Responsive for iPad / medium devices */
@media (min-width: 481px) and (max-width: 1024px) {
    h1 {
        font-size: 1.7rem;
    }
    p {
        font-size: 15px;
    }
    button {
        padding: 12px 22px;
        font-size: 15px;
    }
}
</style>
</head>

<body>

<div class="container" id="card">
    <div class="heart">❤️</div>
    <h1>Hi Shaina Antonette</h1>
    <p>
        From: Hanz Ezekiel ❤️<br><br>
        Be the 6 to my 7... forever?
    </p>

    <div class="buttons">
        <button id="yesBtn">Yes 💖</button>
        <button id="noBtn">No</button>
    </div>
</div>

<script>
const yesBtn = document.getElementById("yesBtn");
const noBtn = document.getElementById("noBtn");
const card = document.getElementById("card");

// Move "No" button when hovered
noBtn.addEventListener("mouseover", () => {
    const containerWidth = card.offsetWidth;
    const containerHeight = 100; // buttons container height
    const x = Math.random() * (containerWidth - noBtn.offsetWidth);
    const y = Math.random() * (containerHeight - noBtn.offsetHeight);
    noBtn.style.left = x + "px";
    noBtn.style.top = y + "px";
});

// When she clicks Yes
yesBtn.addEventListener("click", () => {
    card.innerHTML = `
        <div class="heart">💘</div>
        <p class="success">
        67!! I love you, Shaina Antonette! ❤️<br><br>
        Forever yours,<br>
        Hanz Ezekiel
        </p>
    `;
});
</script>

</body>
</html>

